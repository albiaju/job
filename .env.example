# ==============================================================================
# 🎯 Daily Job Scraper - Configuration
# ==============================================================================

# Email recipients
SENDER_EMAIL=your_email@gmail.com
RECIPIENT_EMAIL=your_email@gmail.com

# Apify API Token (Get one free at https://apify.com)
APIFY_TOKEN=your_apify_api_token
APIFY_ACTOR_ID=curious_coder/linkedin-jobs-scraper

# Gmail API Credentials (Google Cloud Console OAuth 2.0 Client ID)
GMAIL_CREDENTIALS_FILE=gmail_credentials.json
GMAIL_TOKEN_FILE=token.json

# Optional: Inlined JSON secrets for headless GitHub Actions CI
# GMAIL_CREDENTIALS_JSON=
# GMAIL_TOKEN_JSON=

# Optional: SMTP fallback (if you prefer using an App Password instead of OAuth2)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Daily Schedule Time in IST (UTC+5:30) - 8:00 PM IST
DAILY_TIME_IST=20:00
